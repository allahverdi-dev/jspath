{
  "name": "jspath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JSPath — a free, structured JavaScript learning platform: zero to professional.",
  "scripts": {
    "predev": "node scripts/generate-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-manifest.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.mjs,.cjs --max-warnings=0",
    "pretest": "node scripts/generate-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:manifest": "node scripts/generate-manifest.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "content:verify": "node scripts/verify-solutions.mjs",
    "content:examples": "node scripts/verify-examples.mjs",
    "content:premium": "node scripts/build-premium-payload.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@paddle/paddle-js": "^1.6.5",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
