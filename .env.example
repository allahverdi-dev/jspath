# Optional. Without these, JSPath runs in guest mode and everything still works.
# See docs/SUPABASE.md for the schema and RLS policies.
VITE_SUPABASE_URL=
# Preferred for newer Supabase projects. The legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Which checkout this deployment offers for NEW purchases.
#   gumroad-production   production today. Real money through Gumroad.
#   paddle-sandbox       staging / owner testing only.
#   paddle-production    after live cutover. Not enabled yet.
# Unset or unrecognised means gumroad-production, so a typo can never promote
# sandbox checkout to real learners.
VITE_BILLING_MODE=gumroad-production

# Paddle Billing, browser side. The client-side token is designed to be public:
# it can open a checkout and nothing else. It is NOT the Paddle API key.
VITE_PADDLE_CLIENT_TOKEN=
# Exactly "sandbox" or "production". Anything else disables checkout rather than
# guessing, so a typo cannot point sandbox code at the live account.
VITE_PADDLE_ENVIRONMENT=sandbox

# Legacy Gumroad checkout links. New purchases go through Paddle; these are kept
# only while existing Gumroad subscriptions are still running.
VITE_GUMROAD_PRO_MONTHLY_URL=
VITE_GUMROAD_PRO_ANNUAL_URL=

# ---------------------------------------------------------------------------
# Server-only. These are NEVER prefixed VITE_ and never reach the browser: they
# are set as Supabase Edge Function secrets, not in this file and not in Vercel's
# frontend environment. Listed here by name only, so the set is discoverable.
#
#   SUPABASE_SERVICE_ROLE_KEY
#
#   Paddle Billing (new subscriptions):
#   PADDLE_API_KEY                 server-side key. Never VITE_, never in the browser.
#   PADDLE_ENVIRONMENT             "sandbox" or "production"
#   PADDLE_PRODUCT_ID              pro_... for JSPath Pro
#   PADDLE_PRO_MONTHLY_PRICE_ID    pri_... monthly
#   PADDLE_PRO_ANNUAL_PRICE_ID     pri_... annual
#   PADDLE_WEBHOOK_SECRET          the notification destination's secret
#   PADDLE_SANDBOX_TESTER_IDS      comma-separated Supabase user UUIDs allowed to
#                                  use Paddle SANDBOX. Empty means nobody, which
#                                  is the safe default. Ignored in production.
#   PADDLE_WEBHOOK_TOLERANCE_SECONDS
#                                  optional. Defaults to Paddle's documented 5.
#                                  Only raise it with measured evidence that real
#                                  deliveries are being rejected.
#
#   Gumroad (legacy subscriptions only):
#   GUMROAD_ACCESS_TOKEN
#   GUMROAD_WEBHOOK_TOKEN
#   GUMROAD_ALLOWED_PRODUCTS_JSON
#   GUMROAD_USER_ID_FIELD
#
# See docs/DEPLOYMENT.md.
