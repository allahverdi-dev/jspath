# Optional. Without these, JSPath runs in guest mode and everything still works.
# See docs/SUPABASE.md for the schema and RLS policies.
VITE_SUPABASE_URL=
# Preferred for newer Supabase projects. The legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional public Gumroad checkout links. These are not secrets and never prove payment.
VITE_GUMROAD_PRO_MONTHLY_URL=
VITE_GUMROAD_PRO_ANNUAL_URL=

# ---------------------------------------------------------------------------
# Server-only. These are NEVER prefixed VITE_ and never reach the browser: they
# are set as Supabase Edge Function secrets, not in this file and not in Vercel's
# frontend environment. Listed here by name only, so the set is discoverable.
#
#   SUPABASE_SERVICE_ROLE_KEY
#   GUMROAD_ACCESS_TOKEN
#   GUMROAD_WEBHOOK_TOKEN
#   GUMROAD_ALLOWED_PRODUCTS_JSON
#   GUMROAD_USER_ID_FIELD
#
# See docs/DEPLOYMENT.md.
